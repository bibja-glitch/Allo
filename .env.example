# ==============================================================================
# АЛЛО, РОУД! — ASCII CHAOS (Telegram Bot)
# Copy this file to .env.local (local) or add in Vercel -> Project Settings -> Environment Variables.
# NEVER commit real tokens or secrets to GitHub!
# ==============================================================================

# Telegram Bot API (получить у @BotFather)
TELEGRAM_BOT_TOKEN=""
# Любая случайная строка для проверки заголовка X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=""
# Имя бота без @ (например: AlloRoadFatalityBot)
TELEGRAM_BOT_USERNAME=""

# Upstash Redis REST API (Upstash Console -> REST API -> UPSTASH_REDIS_REST_URL & UPSTASH_REDIS_REST_TOKEN)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Публичный HTTPS-адрес Vercel (для регистрации Webhook через /api/telegram/setup)
APP_URL="https://your-project.vercel.app"

# Опционально: отдельный секрет для /api/telegram/setup и /api/telegram/cleanup
ADMIN_SETUP_SECRET=""
CRON_SECRET=""
